# genesis-fts.env — EnvironmentFile do genesis-full-test.service (FTS).
#
# ⚠️ TEMPLATE VERSIONADO — SEM valores reais. O arquivo real vive em
#    /etc/systemd/genesis-fts.env no host de prod, chmod 600, root:root, FORA do git.
#    Preencher os placeholders <...> no host; nunca commitar valores reais.
#
# Após editar o arquivo real:
#   sudo systemctl restart genesis-full-test.service
# Se rotacionar FTS_AUTH_TOKEN, rotacionar TAMBÉM em /opt/zentriz-genesis/.env
# (consumido por api/runner/cyborg/agents) e recriar esses containers — os dois
# lados precisam do MESMO valor (o FTS valida X-FTS-Token com hmac.compare_digest).

# Porta HTTP local do FTS (borda só na loopback + host.docker.internal; ver Security Group).
FULL_TEST_PORT=7878

# AV/A-6: endereço(s) de escuta (IP, ou vários separados por vírgula). Padrão do servidor: 127.0.0.1 (só o próprio host).
# Os containers do compose chegam por `host.docker.internal` (host-gateway = IP da bridge do Docker, 172.17.0.1 no padrão):
# para eles, use "127.0.0.1,172.17.0.1". Confira o IP real: `ip -4 addr show docker0`. NUNCA 0.0.0.0 (exige FTS_ALLOW_ANY_BIND=1).
# Firewall versionado: scripts/dev/fts-firewall.sh (--check só lê). Subida de dev: scripts/dev/start-fts.sh.
FTS_BIND=127.0.0.1,172.17.0.1

# AV/B-2: papel do host. Em PRODUÇÃO o FTS roda código do produto (npm/jest/claude) no host do control plane: só marque
# FTS_ISOLATED_EXECUTOR=1 depois de isolar o executor (project/docs/analysis/EVOLUIR-PROJETO-AX-b2-isolamento-executor.md).
# FTS_HOST_ROLE=development

# Nº máximo de jobs pesados (build/test) simultâneos.
HEAVY_JOBS_MAX=2

# Binário do Claude Code e modo Bedrock (execução autônoma de engenharia).
CLAUDE_BIN=/usr/bin/claude
CLAUDE_CODE_USE_BEDROCK=1
ANTHROPIC_DEFAULT_SONNET_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Região AWS.
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# 🔴 PREFERIR INSTANCE ROLE da EC2 em vez destas chaves estáticas (ver .service.template).
#    Mantidas aqui só enquanto a migração para role não é feita.
AWS_ACCESS_KEY_ID=<use-instance-role-ou-preencher-no-host>
AWS_SECRET_ACCESS_KEY=<use-instance-role-ou-preencher-no-host>

# Token que o FTS exige no header X-FTS-Token de todo POST (fail-closed).
# Gerar com: openssl rand -hex 32 . Espelhar em /opt/zentriz-genesis/.env.
FTS_AUTH_TOKEN=<openssl-rand-hex-32>

# Token do FTS para chamar de volta a API Genesis (heartbeat/resultado).
GENESIS_API_TOKEN=<jwt-de-servico-do-genesis>

# URL da API do host para o Cyborg (callback).
CYBORG_HOST_API_URL=<http://host.docker.internal:3000-ou-equivalente>
